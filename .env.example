# ==============================================================================
# TaskFlow — Student Task Management System Environment Configuration
# ==============================================================================
# Copy this file to .env and customize for your local or production environment.
# Never commit real secrets or production credentials to version control.
# ==============================================================================

# Flask Secret Key
# Used for cryptographically signing Flask sessions and Bearer auth tokens.
# In production, generate a secure random string (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Flask Environment & Debugging Mode
# Set FLASK_DEBUG=True for local development with auto-reload, False in production
FLASK_DEBUG=True
FLASK_ENV=development

# Server Binding Host & Port (Render automatically injects PORT)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
PORT=5000

# SQLite Database Location
# Relative path from project root or absolute path
DATABASE_PATH=database/taskflow.db

# Cross-Origin Resource Sharing (CORS) Allowed Origins
# Comma-separated list or '*' for local development
CORS_ORIGINS=*

# Session Cookie Security Flags
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=False

